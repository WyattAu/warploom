#version 450

// cull_hiz_sampled.comp — sampled-image hierarchical-Z culling.
// Binding 0 contains instance spheres and output counters; binding 1 is a
// sampled R32F pyramid whose mip levels are selected from the projected
// footprint. The pyramid is previous-frame data, so the test is conservative
// and intentionally one frame behind rendering.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) buffer Cull {
  uint words[];
} cull;
layout(set = 0, binding = 1) uniform sampler2D hiz_pyramid;
layout(set = 0, binding = 2, std430) buffer Draw {
  uint command[];
};

layout(push_constant) uniform Push {
  uint sphere_offset;
  uint compact_offset;
  uint pyramid_width;
  uint pyramid_height;
  uint instance_count;
  uint near_z;
  uint far_z;
  uint width;
  uint height;
  uint tile_size;
  uint levels;
} push;

float nearest_depth(vec3 center, float radius) {
  const float near_z = uintBitsToFloat(push.near_z);
  const float far_z = uintBitsToFloat(push.far_z);
  const float inv_range = 1.0 / (far_z - near_z);
  const float c1 = (far_z + near_z) * inv_range;
  const float c2 = 2.0 * far_z * near_z * inv_range;
  const float view_depth = max(-center.z - radius, near_z);
  return clamp(c1 - c2 / view_depth, 0.0, 1.0);
}

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= push.instance_count) return;

  const uint s = push.sphere_offset + i * 4u;
  const vec3 center = vec3(uintBitsToFloat(cull.words[s]),
                           uintBitsToFloat(cull.words[s + 1u]),
                           uintBitsToFloat(cull.words[s + 2u]));
  const float radius = uintBitsToFloat(cull.words[s + 3u]);

  if (center.z > -0.1 || center.z < -100.0) {
    atomicAdd(cull.words[2], 1u); // frustum culled
    return;
  }

  const float depth = nearest_depth(center, radius);
  const vec2 uv_center = center.xy / (-center.z * vec2(1.2)) * 0.5 + 0.5;
  const float projected_radius = radius / (-center.z * 1.2) * 0.5;
  const vec2 uv_min = clamp(uv_center - projected_radius, vec2(0.0), vec2(1.0));
  const vec2 uv_max = clamp(uv_center + projected_radius, vec2(0.0), vec2(1.0));
  const vec2 footprint = (uv_max - uv_min) * vec2(push.pyramid_width, push.pyramid_height);

  uint level = 0u;
  for (uint l = 0u; l + 1u < push.levels; ++l) {
    if (max(footprint.x, footprint.y) <= 2.0 * float(1u << l)) break;
    level = l + 1u;
  }
  const uint dim_x = max(1u, push.pyramid_width >> level);
  const uint dim_y = max(1u, push.pyramid_height >> level);
  const ivec2 min_texel = ivec2(clamp(uv_min * vec2(dim_x, dim_y), vec2(0.0), vec2(dim_x - 1u)));
  const ivec2 max_texel = ivec2(clamp(uv_max * vec2(dim_x, dim_y), vec2(0.0), vec2(dim_x - 1u, dim_y - 1u)));

  bool covered = true;
  bool sampled = false;
  for (int y = min_texel.y; y <= max_texel.y; ++y) {
    for (int x = min_texel.x; x <= max_texel.x; ++x) {
      const float occluder_depth = texelFetch(hiz_pyramid, ivec2(x, y), int(level)).r;
      sampled = true;
      covered = covered && occluder_depth < depth;
    }
  }
  if (sampled && covered) {
    atomicAdd(cull.words[3], 1u); // occlusion culled
    return;
  }

  const uint slot = atomicAdd(cull.words[1], 1u);
  cull.words[push.compact_offset + slot] = i;
  atomicAdd(command[1], 1u);
  atomicAdd(cull.words[0], 1u); // accepted
}
