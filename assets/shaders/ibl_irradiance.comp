#version 450

// ibl_irradiance.comp — diffuse-IBL irradiance bake. Cosine-weighted Monte
// Carlo over the hemisphere above each cube texel direction averages the sky
// radiance:  irradiance(N) = (1/N) sum_i sky(L_i), L_i ~ cos(theta)/pi.
// The consuming fragment shader evaluates kD * albedo * irradiance(N),
// which reproduces albedo * (1/pi) * integral Li(N.L) dw for uniform skies.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D sky_sampler;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray out_cube;

const uint kSampleCount = 64u;

float radical_inverse_vdc(uint bits) {
  bits = (bits << 16u) | (bits >> 16u);
  bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
  bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
  bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
  bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
  return float(bits) * 2.3283064365386963e-10;
}

vec2 hammersley(uint i) {
  return vec2(float(i) / float(kSampleCount), radical_inverse_vdc(i));
}

mat3 tangent_frame(vec3 n) {
  vec3 up = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
  vec3 t = normalize(cross(up, n));
  vec3 b = cross(n, t);
  return mat3(t, b, n);
}

vec3 sample_sky(vec3 d) {
  const float phi = atan(d.z, d.x);
  const float theta = acos(clamp(d.y, -1.0, 1.0));
  const vec2 uv = vec2(phi / 6.28318530718f + 0.5, theta / 3.14159265359f);
  return texture(sky_sampler, uv).rgb;
}

vec3 face_direction(uint layer, float u, float v) {
  vec3 d;
  if (layer == 0u) {
    d = vec3(1.0, -v, -u);
  } else if (layer == 1u) {
    d = vec3(-1.0, -v, u);
  } else if (layer == 2u) {
    d = vec3(u, 1.0, v);
  } else if (layer == 3u) {
    d = vec3(u, -1.0, -v);
  } else if (layer == 4u) {
    d = vec3(u, -v, 1.0);
  } else {
    d = vec3(-u, -v, -1.0);
  }
  return normalize(d);
}

void main() {
  const ivec3 p = ivec3(gl_GlobalInvocationID);
  const ivec3 size = imageSize(out_cube);
  if (p.x >= size.x || p.y >= size.y || p.z >= size.z) {
    return;
  }

  const float ru = (float(p.x) + 0.5f) / float(size.x) * 2.0f - 1.0f;
  const float rv = (float(p.y) + 0.5f) / float(size.y) * 2.0f - 1.0f;
  const vec3 n = face_direction(uint(p.z), ru, rv);

  vec3 acc = vec3(0.0);
  for (uint i = 0u; i < kSampleCount; ++i) {
    const vec2 xi = hammersley(i);
    // Cosine-weighted sample over the hemisphere around n.
    const float phi = 6.28318530718f * xi.x;
    const float sin_theta = sqrt(max(xi.y, 0.0));
    const float cos_theta = sqrt(max(1.0 - xi.y, 0.0));
    const vec3 l = normalize(tangent_frame(n) *
                             vec3(cos(phi) * sin_theta, sin(phi) * sin_theta,
                                  cos_theta));
    acc += sample_sky(l);
  }
  imageStore(out_cube, p, vec4(acc / float(kSampleCount), 1.0));
}
